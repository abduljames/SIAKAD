# Dipakai Vite saat "npm run build" (mode production).
# Subdomain siakad.* di IP VPS yang sama dengan Koperasi (sslip.io otomatis
# resolve subdomain apa pun ke IP itu). /api di-reverse-proxy oleh nginx milik
# Koperasi ke container siakad_backend_prod (lihat nginx.conf project Koperasi).
# Ganti ke domain asli begitu sudah ada, lalu build ulang (VITE_API_URL di-bake
# ke file JS saat build, tidak bisa diubah lewat .env di server tanpa build ulang).
VITE_API_URL=https://siakad.103.197.188.61.sslip.io/api
